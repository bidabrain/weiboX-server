# 复制为 .env 并按需修改（docker-compose 会自动读取，本地运行用 `--env-file .env`）

# 监听
WEIBOX_HOST=0.0.0.0
WEIBOX_PORT=8000

# 数据目录（SQLite / token / secret 持久化于此）
WEIBOX_DATA_DIR=./data

# WebUI 管理密码（务必修改）
WEIBOX_ADMIN_PASSWORD=change-me

# 可选的固定「主」API Token（永久有效）。一般留空，改在 WebUI「设置 → API Token」里管理。
WEIBOX_API_TOKEN=

# 会话签名密钥，留空则自动生成到 DATA_DIR/secret_key.txt
WEIBOX_SECRET_KEY=

# 是否启用无头浏览器（访客 session 引导 + 验证码交互）。本地无 Chromium 时设 false。
WEIBOX_ENABLE_BROWSER=true

# FCM 服务账号私钥路径。留空则用 DATA_DIR/firebase-key.json。文件存在才启用推送。
WEIBOX_FIREBASE_KEY=
